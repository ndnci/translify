{
  "name": "@ndnci/translify-ai",
  "version": "0.0.1",
  "private": true,
  "description": "AI translation providers for the Translify i18n toolkit",
  "keywords": [
    "i18n",
    "translify",
    "ai",
    "openai",
    "translation"
  ],
  "homepage": "https://ndnci.github.io/translify/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ndnci/translify.git",
    "directory": "packages/ai"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ndnci/translify-config": "workspace:*",
    "@ndnci/translify-shared": "workspace:*",
    "@openrouter/sdk": "^0.13.24",
    "openai": "^6.45.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
