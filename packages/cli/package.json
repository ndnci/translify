{
  "name": "@ndnci/translify",
  "version": "0.5.2",
  "description": "Intelligent i18n CLI — extract, sync, detect, and translate your app",
  "keywords": [
    "i18n",
    "cli",
    "translation",
    "internationalisation",
    "internationalization",
    "localization",
    "next-intl",
    "i18next",
    "react",
    "nextjs"
  ],
  "homepage": "https://ndnci.github.io/translify/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ndnci/translify.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "translify": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config-entry.d.ts",
      "import": "./dist/config-entry.js",
      "require": "./dist/config-entry.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist",
    "prepack": "cp ../../README.md ./README.md",
    "postpack": "rm -f ./README.md"
  },
  "dependencies": {
    "@babel/parser": "^7.26.2",
    "@babel/traverse": "^7.26.4",
    "@babel/types": "^7.26.3",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.2",
    "jiti": "^1.21.6",
    "jsonc-parser": "^3.3.1",
    "openai": "^6.45.0",
    "ora": "^8.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@ndnci/translify-ai": "workspace:*",
    "@ndnci/translify-config": "workspace:*",
    "@ndnci/translify-core": "workspace:*",
    "@ndnci/translify-shared": "workspace:*",
    "@types/node": "^22.10.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
