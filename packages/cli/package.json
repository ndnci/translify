{
  "name": "@ndnci/translify",
  "version": "1.0.0",
  "description": "Complete client and server i18n runtime, framework adapters, studio, and CLI",
  "keywords": [
    "i18n",
    "cli",
    "translation",
    "internationalisation",
    "internationalization",
    "localization",
    "next-intl",
    "i18next",
    "react",
    "nextjs",
    "vue",
    "svelte",
    "angular",
    "solidjs"
  ],
  "homepage": "https://ndnci.github.io/translify/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ndnci/translify.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "translify": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config-entry.d.ts",
      "import": "./dist/config-entry.js",
      "require": "./dist/config-entry.cjs"
    },
    "./locales": {
      "types": "./dist/locales-entry.d.ts",
      "import": "./dist/locales-entry.js",
      "require": "./dist/locales-entry.cjs"
    },
    "./vanilla": {
      "types": "./dist/runtime-entry.d.ts",
      "import": "./dist/runtime-entry.js",
      "require": "./dist/runtime-entry.cjs"
    },
    "./runtime": {
      "types": "./dist/runtime-entry.d.ts",
      "import": "./dist/runtime-entry.js",
      "require": "./dist/runtime-entry.cjs"
    },
    "./react": {
      "types": "./dist/react-entry.d.ts",
      "import": "./dist/react-entry.js",
      "require": "./dist/react-entry.cjs"
    },
    "./next": {
      "types": "./dist/next-entry.d.ts",
      "import": "./dist/next-entry.js",
      "require": "./dist/next-entry.cjs"
    },
    "./server": {
      "types": "./dist/server-entry.d.ts",
      "import": "./dist/server-entry.js",
      "require": "./dist/server-entry.cjs"
    },
    "./vue": {
      "types": "./dist/vue-entry.d.ts",
      "import": "./dist/vue-entry.js",
      "require": "./dist/vue-entry.cjs"
    },
    "./svelte": {
      "types": "./dist/svelte-entry.d.ts",
      "import": "./dist/svelte-entry.js",
      "require": "./dist/svelte-entry.cjs"
    },
    "./angular": {
      "types": "./dist/angular-entry.d.ts",
      "import": "./dist/angular-entry.js",
      "require": "./dist/angular-entry.cjs"
    },
    "./solid": {
      "types": "./dist/solid-entry.d.ts",
      "import": "./dist/solid-entry.js",
      "require": "./dist/solid-entry.cjs"
    }
  },
  "sideEffects": [
    "./dist/index.js"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist",
    "prepack": "cp ../../README.md ./README.md",
    "postpack": "rm -f ./README.md"
  },
  "dependencies": {
    "@babel/parser": "^7.26.2",
    "@babel/traverse": "^7.26.4",
    "@babel/types": "^7.26.3",
    "@openrouter/sdk": "^0.13.24",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.2",
    "intl-messageformat": "^10.7.18",
    "jiti": "^1.21.6",
    "jsonc-parser": "^3.3.1",
    "openai": "^6.45.0",
    "ora": "^8.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@angular/core": "^20.3.27",
    "@ndnci/translify-ai": "workspace:*",
    "@ndnci/translify-config": "workspace:*",
    "@ndnci/translify-core": "workspace:*",
    "@ndnci/translify-runtime": "workspace:*",
    "@ndnci/translify-shared": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.3",
    "react": "^19.0.0",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.2",
    "solid-js": "^1.9.14",
    "svelte": "^5.56.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "vue": "^3.5.34"
  },
  "peerDependencies": {
    "@angular/core": ">=18.0.0",
    "react": ">=18.0.0",
    "solid-js": ">=1.8.0",
    "svelte": ">=4.0.0",
    "vue": ">=3.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
