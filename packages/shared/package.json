{
  "name": "@ndnci/translify-shared",
  "version": "0.1.0",
  "description": "Shared types, utilities, and constants for the Translify i18n toolkit",
  "keywords": [
    "i18n",
    "translify",
    "translation",
    "shared"
  ],
  "homepage": "https://translify.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/ndnci/translify.git",
    "directory": "packages/shared"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
